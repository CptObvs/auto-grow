# secrets.yaml — WiFi- und OTA-Zugangsdaten
#
# ⚠️  Diese Datei NICHT committen — sie ist in .gitignore eingetragen!
#     Kopiere diese Datei als secrets.yaml und trage deine Daten ein:
#     cp secrets.yaml.example secrets.yaml

wifi_ssid: "DeinNetzwerkName"
wifi_password: "DeinWiFiPasswort"

# Fallback-Hotspot Passwort (mindestens 8 Zeichen)
ap_password: "autogrow123"

# OTA Update Passwort (frei wählbar)
ota_password: "ota_passwort_aendern"

# ESPHome API Schlüssel (32 Byte Base64 — generieren mit:)
# python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "HIER_32_BYTE_BASE64_SCHLUESSEL_EINTRAGEN="
